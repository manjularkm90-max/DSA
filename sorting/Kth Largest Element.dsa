import java.util.*;

public class Main {

    public static void main(String[] args) {

        int[] arr = {3, 2, 1, 5, 6, 4};
        int k = 2;

        Integer[] nums = new Integer[arr.length];

        for (int i = 0; i < arr.length; i++)
            nums[i] = arr[i];

        Arrays.sort(nums, Collections.reverseOrder());

        System.out.println(nums[k - 1]);
    }
}
