import java.util.*;

public class RatMaze {

    static List<String> result = new ArrayList<>();

    public static List<String> findPaths(int[][] maze) {

        int n = maze.length;

        boolean[][] visited = new boolean[n][n];

        solve(maze, 0, 0, "", visited);

        return result;
    }

    static void solve(
            int[][] maze,
            int row,
            int col,
            String path,
            boolean[][] visited) {

        int n = maze.length;

        // Invalid
        if (row < 0 || col < 0 ||
            row >= n || col >= n ||
            maze[row][col] == 0 ||
            visited[row][col]) {

            return;
        }

        // Destination
        if (row == n - 1 && col == n - 1) {
            result.add(path);
            return;
        }

        visited[row][col] = true;

        // Down
        solve(maze, row + 1, col,
              path + "D", visited);

        // Left
        solve(maze, row, col - 1,
              path + "L", visited);

        // Right
        solve(maze, row, col + 1,
              path + "R", visited);

        // Up
        solve(maze, row - 1, col,
              path + "U", visited);

        // Backtrack
        visited[row][col] = false;
    }
}
