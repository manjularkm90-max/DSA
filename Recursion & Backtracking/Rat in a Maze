public class RatMaze {

    static int n;

    static boolean solve(int[][] maze,
                         int row,
                         int col,
                         int[][] path) {

        if (row == n - 1 && col == n - 1) {

            path[row][col] = 1;
            return true;
        }

        if (row < 0 || col < 0 ||
            row >= n || col >= n ||
            maze[row][col] == 0 ||
            path[row][col] == 1) {

            return false;
        }

        path[row][col] = 1;

        if (solve(maze, row + 1, col, path) ||
            solve(maze, row, col + 1, path) ||
            solve(maze, row - 1, col, path) ||
            solve(maze, row, col - 1, path)) {

            return true;
        }

        path[row][col] = 0;

        return false;
    }
}
