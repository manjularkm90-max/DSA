public class GraphColoring {

    static boolean graphColoring(
            int[][] graph,
            int m) {

        int n = graph.length;

        int[] color = new int[n];

        return solve(graph, color, m, 0);
    }

    static boolean solve(
            int[][] graph,
            int[] color,
            int m,
            int vertex) {

        int n = graph.length;

        if (vertex == n) {
            return true;
        }

        for (int c = 1; c <= m; c++) {

            if (isSafe(graph, color, vertex, c)) {

                color[vertex] = c;

                if (solve(graph, color, m, vertex + 1)) {
                    return true;
                }

                // Backtrack
                color[vertex] = 0;
            }
        }

        return false;
    }

    static boolean isSafe(
            int[][] graph,
            int[] color,
            int vertex,
            int c) {

        for (int i = 0; i < graph.length; i++) {

            if (graph[vertex][i] == 1 &&
                color[i] == c) {

                return false;
            }
        }

        return true;
    }
}
