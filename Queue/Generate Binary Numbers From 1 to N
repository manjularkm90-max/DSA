import java.util.*;

public class BinaryNumbers {

    public static void generate(int n) {

        Queue<String> q = new LinkedList<>();

        q.offer("1");

        for (int i = 0; i < n; i++) {

            String current = q.poll();

            System.out.println(current);

            q.offer(current + "0");
            q.offer(current + "1");
        }
    }

    public static void main(String[] args) {
        generate(5);
    }
}
