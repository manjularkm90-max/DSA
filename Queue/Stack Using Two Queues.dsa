import java.util.*;

class StackUsingQueues {

    Queue<Integer> q1 = new LinkedList<>();
    Queue<Integer> q2 = new LinkedList<>();

    void push(int x) {
        q2.offer(x);

        while (!q1.isEmpty()) {
            q2.offer(q1.poll());
        }

        Queue<Integer> temp = q1;
        q1 = q2;
        q2 = temp;
    }

    int pop() {
        if (q1.isEmpty()) {
            throw new RuntimeException("Stack Empty");
        }

        return q1.poll();
    }

    int top() {
        if (q1.isEmpty()) {
            throw new RuntimeException("Stack Empty");
        }

        return q1.peek();
    }
}
