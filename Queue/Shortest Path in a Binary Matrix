int shortestPath(vector<vector<int>>& grid) {
    int n = grid.size();

    if (grid[0][0] || grid[n-1][n-1])
        return -1;

    queue<pair<int,int>> q;
    q.push({0, 0});

    vector<vector<int>> dist(n, vector<int>(n, -1));
    dist[0][0] = 1;

    int dx[] = {-1,-1,-1,0,0,1,1,1};
    int dy[] = {-1,0,1,-1,1,-1,0,1};

    while (!q.empty()) {
        auto [x, y] = q.front();
        q.pop();

        if (x == n-1 && y == n-1)
            return dist[x][y];

        for (int d = 0; d < 8; d++) {
            int nx = x + dx[d];
            int ny = y + dy[d];

            if (nx >= 0 && nx < n &&
                ny >= 0 && ny < n &&
                grid[nx][ny] == 0 &&
                dist[nx][ny] == -1) {

                dist[nx][ny] = dist[x][y] + 1;
                q.push({nx, ny});
            }
        }
    }

    return -1;
}
