import java.util.*;

class Main {

    public static void firstNonRepeating(String s) {

        int[] freq = new int[26];

        Queue<Character> q = new LinkedList<>();

        for (char ch : s.toCharArray()) {

            freq[ch - 'a']++;
            q.offer(ch);

            while (!q.isEmpty() &&
                   freq[q.peek() - 'a'] > 1) {
                q.poll();
            }

            if (q.isEmpty()) {
                System.out.print("# ");
            } else {
                System.out.print(q.peek() + " ");
            }
        }
    }

    public static void main(String[] args) {
        firstNonRepeating("aabc");
    }
}
