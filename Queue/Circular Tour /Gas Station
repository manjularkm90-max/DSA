int circularTour(vector<int>& petrol, vector<int>& distance) {
    int start = 0;
    int balance = 0;
    int total = 0;

    for (int i = 0; i < petrol.size(); i++) {
        int diff = petrol[i] - distance[i];

        balance += diff;
        total += diff;

        if (balance < 0) {
            start = i + 1;
            balance = 0;
        }
    }

    return total >= 0 ? start : -1;
}
