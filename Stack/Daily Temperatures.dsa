import java.util.*;

class Main {
    public static void main(String[] args) {

        int[] temp = {73, 74, 75, 71, 69, 72, 76, 73};

        int[] ans = new int[temp.length];

        Stack<Integer> st = new Stack<>();

        for (int i = 0; i < temp.length; i++) {

            while (!st.isEmpty() && temp[i] > temp[st.peek()]) {

                int index = st.pop();

                ans[index] = i - index;
            }

            st.push(i);
        }

        for (int x : ans) {
            System.out.print(x + " ");
        }
    }
}
