import java.util.*;

class Main {
    public static void main(String[] args) {

        String s = "23+";

        Stack<Integer> stack = new Stack<>();

        for (char ch : s.toCharArray()) {

            if (Character.isDigit(ch)) {
                stack.push(ch - '0');
            }
            else {

                int b = stack.pop();
                int a = stack.pop();

                if (ch == '+')
                    stack.push(a + b);
                else if (ch == '-')
                    stack.push(a - b);
                else if (ch == '*')
                    stack.push(a * b);
                else if (ch == '/')
                    stack.push(a / b);
            }
        }

        System.out.println(stack.pop());
    }
}
