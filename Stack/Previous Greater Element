import java.util.*;

class Main {
    public static void main(String[] args) {

        int[] arr = {10, 4, 2, 20, 40, 12, 30};

        Stack<Integer> st = new Stack<>();

        for (int x : arr) {

            while (!st.isEmpty() && st.peek() <= x) {
                st.pop();
            }

            if (st.isEmpty())
                System.out.print("-1 ");
            else
                System.out.print(st.peek() + " ");

            st.push(x);
        }
    }
}
