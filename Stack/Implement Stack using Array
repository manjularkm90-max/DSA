class Stack {
    int[] arr = new int[5];
    int top = -1;

    void push(int x) {
        if (top == arr.length - 1) {
            System.out.println("Stack Overflow");
        } else {
            arr[++top] = x;
        }
    }

    void pop() {
        if (top == -1) {
            System.out.println("Stack Underflow");
        } else {
            System.out.println("Removed: " + arr[top--]);
        }
    }

    void peek() {
        if (top == -1)
            System.out.println("Stack is empty");
        else
            System.out.println("Top: " + arr[top]);
    }
}
