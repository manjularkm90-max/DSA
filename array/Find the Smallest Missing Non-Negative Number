class Solution {
    static int missing(int arr[]) {
        int low = 0, high = arr.length - 1;

        while (low <= high) {
            int mid = (low + high) / 2;

            if (arr[mid] == mid)
                low = mid + 1;
            else
                high = mid - 1;
        }
        return low;
    }

    public static void main(String[] args) {
        int arr[] = {0,1,2,6,9,11,15};
        System.out.println(missing(arr));
    }
}
