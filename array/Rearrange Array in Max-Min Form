class Solution{

    public static void main(String args[]){

        int arr[]={1,2,3,4,5,6};

        int temp[]=new int[arr.length];

        int l=0,r=arr.length-1;

        int k=0;

        while(l<=r){

            if(l!=r)
                temp[k++]=arr[r--];

            temp[k++]=arr[l++];
        }

        for(int x:temp)
            System.out.print(x+" ");
    }
}
