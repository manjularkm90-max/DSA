import java.util.*;

class Solution {
    public int constrainedSubsetSum(int[] nums, int k) {

        Deque<int[]> dq = new ArrayDeque<>();

        int answer = Integer.MIN_VALUE;

        for (int i = 0; i < nums.length; i++) {

            while (!dq.isEmpty() &&
                   dq.peekFirst()[0] < i - k) {
                dq.pollFirst();
            }

            int current = nums[i];

            if (!dq.isEmpty()) {
                current += Math.max(0, dq.peekFirst()[1]);
            }

            while (!dq.isEmpty() &&
                   dq.peekLast()[1] <= current) {
                dq.pollLast();
            }

            dq.offerLast(new int[]{i, current});

            answer = Math.max(answer, current);
        }

        return answer;
    }
}
