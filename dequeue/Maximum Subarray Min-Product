import java.util.*;

class Solution {
    public long maxSumMinProduct(int[] nums) {

        int n = nums.length;

        long[] prefix = new long[n + 1];

        for (int i = 0; i < n; i++) {
            prefix[i + 1] =
                prefix[i] + nums[i];
        }

        Deque<Integer> stack = new ArrayDeque<>();

        long answer = 0;

        for (int i = 0; i <= n; i++) {

            long current =
                (i == n) ? Long.MIN_VALUE : nums[i];

            while (!stack.isEmpty() &&
                   nums[stack.peek()] >= current) {

                int index = stack.pop();

                int left =
                    stack.isEmpty()
                    ? 0
                    : stack.peek() + 1;

                int right = i - 1;

                long sum =
                    prefix[right + 1] - prefix[left];

                answer = Math.max(
                    answer,
                    sum * nums[index]
                );
            }

            stack.push(i);
        }

        return answer;
    }
}
